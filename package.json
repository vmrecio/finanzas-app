{
  "name": "finanzas-app",
  "version": "0.0.0",
  "private": true,
  "description": "Personal finance management app (monorepo) — NestJS API + Next.js web, hexagonal architecture.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "postinstall": "pnpm --filter @finanzas/api exec prisma generate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  }
}
