// Prisma schema for finanzas-app.
//
// Domain entities are introduced incrementally, one per capability phase,
// each shipping its own migration alongside that capability's code (see
// design.md "Migration / Rollout"). Phase 1 shipped the baseline
// datasource/generator only; Phase 2 (Auth) added User + RefreshToken;
// Phase 3 (Accounts) adds Account.
//
// Prisma models are infrastructure-only: the domain/application layers never
// import `@prisma/client` directly (see design.md "Migrations / ORM").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id
  email         String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  accounts      Account[]

  @@map("users")
}

enum AccountType {
  bank
  cash
  credit_card
}

model Account {
  id        String      @id
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      AccountType
  createdAt DateTime    @default(now()) @map("created_at")

  // Leading on userId so owner-scoped listing/lookups are index-satisfied
  // (see design.md "Database Schema" indexing strategy).
  @@index([userId])
  @@map("accounts")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
