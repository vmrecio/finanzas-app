// Prisma schema for finanzas-app.
//
// Domain entities are introduced incrementally, one per capability phase,
// each shipping its own migration alongside that capability's code (see
// design.md "Migration / Rollout"). Phase 1 shipped the baseline
// datasource/generator only; Phase 2 (Auth) added User + RefreshToken;
// Phase 3 (Accounts) added Account; Phase 4 (Categories) added Category;
// Phase 5 (Transactions) adds Transaction, the ledger both Account balances
// and Category delete-guards are derived from.
//
// Prisma models are infrastructure-only: the domain/application layers never
// import `@prisma/client` directly (see design.md "Migrations / ORM").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id
  email         String         @unique
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]

  @@map("users")
}

enum AccountType {
  bank
  cash
  credit_card
}

model Account {
  id           String        @id
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  // Leading on userId so owner-scoped listing/lookups are index-satisfied
  // (see design.md "Database Schema" indexing strategy).
  @@index([userId])
  @@map("accounts")
}

enum CategoryKind {
  income
  expense
}

model Category {
  id           String        @id
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         CategoryKind
  createdAt    DateTime      @default(now()) @map("created_at")
  transactions Transaction[]

  // Leading on userId so owner-scoped listing/lookups are index-satisfied
  // (see design.md "Database Schema" indexing strategy). Unique per
  // (userId, name, kind) enforces "Requirement: Category Creation"
  // (duplicate name+kind rejected) at the DB level as defense-in-depth,
  // mirroring the application-layer check in CreateCategoryUseCase.
  @@unique([userId, name, kind])
  @@index([userId])
  @@map("categories")
}

enum TransactionType {
  income
  expense
}

model Transaction {
  id          String          @id
  userId      String          @map("user_id")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String          @map("account_id")
  account     Account         @relation(fields: [accountId], references: [id])
  categoryId  String          @map("category_id")
  category    Category        @relation(fields: [categoryId], references: [id])
  type        TransactionType
  // Signed convention: `type` determines the sign when deriving balances
  // (income adds, expense subtracts) — amountCents itself is always stored
  // positive (see Transaction.create()'s "amount must be positive" invariant
  // and design.md "Money representation": BIGINT cents end-to-end).
  amountCents BigInt          @map("amount_cents")
  occurredOn  DateTime        @map("occurred_on")
  note        String?
  createdAt   DateTime        @default(now()) @map("created_at")

  // Leading on userId so every owner-scoped query is index-satisfied (see
  // design.md "Database Schema" indexing strategy): listing + time-series
  // reporting, spend-by-category aggregation, and per-account balance SUM,
  // respectively. Account/Category deletion guards (existsForAccount /
  // existsForCategory) also benefit from the (userId, accountId) /
  // (userId, categoryId) indexes.
  @@index([userId, occurredOn])
  @@index([userId, categoryId])
  @@index([userId, accountId])
  @@map("transactions")
}

model RefreshToken {
  id        String    @id
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
