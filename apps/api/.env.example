# Postgres connection string. Required — no default.
DATABASE_URL="postgresql://finanzas:finanzas@localhost:5432/finanzas?schema=public"

# Signs/verifies access + refresh JWTs. Set a real secret outside local dev.
JWT_SECRET=dev-secret-change-me

# HTTP port the API listens on.
PORT=3001

# Allowed CORS origin — must match wherever apps/web is served from
# (credentials are enabled, so this cannot be a wildcard).
WEB_ORIGIN=http://localhost:3000